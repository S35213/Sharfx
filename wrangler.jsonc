{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/owner"
    ]
  },
  "observability": {
    "enabled": true
  }
}
