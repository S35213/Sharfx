# SHAFX private owner console. Server-only; never prefix with VITE_.
SHAFX_ADMIN_KEY=replace-with-a-long-random-owner-key

# SHAFX identity/database.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack server integration. Never commit or expose PAYSTACK_SECRET_KEY.
PAYSTACK_SECRET_KEY=
SHAFX_PAYMENTS_ENABLED=false
